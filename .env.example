# ===== Threads API =====
THREADS_ACCESS_TOKEN=여기에_Threads_Access_Token
THREADS_USER_ID=여기에_Threads_User_ID

# ===== Anthropic (Claude) API - 글 자동 작성용 =====
ANTHROPIC_API_KEY=여기에_Claude_API_Key

# ===== Pexels API - 무료 실사 스톡사진 =====
# https://www.pexels.com/api/ 에서 무료 발급
PEXELS_API_KEY=여기에_Pexels_API_Key

# ===== 쿠팡파트너스 오픈API =====
COUPANG_ACCESS_KEY=여기에_쿠팡_Access_Key
COUPANG_SECRET_KEY=여기에_쿠팡_Secret_Key
COUPANG_SUBID=milkyway7           # 링크 추적용 subId (자유롭게 정하면 됨)

# ===== GitHub (이미지 호스팅용, Actions에서는 자동으로 채워짐) =====
GITHUB_REPOSITORY=사용자명/저장소명   # 예: bijo0602/milkyway-auto
GITHUB_BRANCH=main
